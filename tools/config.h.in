#pragma once
#include <xcal/public.h>

#ifdef @IDENT@_ENABLE_DYNAMIC_LIBRARY
#    ifdef @IDENT@_BUILD
#        ifdef _WIN32
// Windows平台
#            ifdef __GNUC__
// 使用GCC编译器
#                define @IDENT@_API __attribute__((dllexport))
#            else
// 使用MSVC或其他Windows编译器
#                define @IDENT@_API __declspec(dllexport)
#            endif
#        else
// 非Windows平台
#            if __GNUC__ >= 4
// 使用GCC 4及以上版本
#                define @IDENT@_API __attribute__((visibility("default")))
#            else
// 其他编译器
#                define @IDENT@_API
#            endif
#        endif
#    else
#        ifdef _WIN32
// Windows平台
#            ifdef __GNUC__
// 使用GCC编译器
#                define @IDENT@_API __attribute__((dllimport))
#            else
// 使用MSVC或其他Windows编译器
#                define @IDENT@_API __declspec(dllimport)
#            endif
#        else
// 非Windows平台
#            if __GNUC__ >= 4
// 使用GCC 4及以上版本
#                define @IDENT@_API __attribute__((visibility("default")))
#            else
// 其他编译器
#                define @IDENT@_API
#            endif
#        endif
#    endif
#else
#    define @IDENT@_API
#endif